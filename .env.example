# Токен бота от @BotFather
BOT_TOKEN=
# Имя бота без @ (для ссылки на сайте)
BOT_USERNAME=
# Публичный адрес сайта: бот даст ссылку на файлы больше 50 МБ
PUBLIC_URL=http://localhost:8000

# Необязательно:
# COOKIES_FILE=cookies.txt      # куки браузера для Instagram/закрытых видео
# BOT_API_URL=http://localhost:8081   # свой Telegram Bot API сервер (файлы до 2 ГБ)
# FILE_TTL=3600                  # сколько секунд хранить файлы
